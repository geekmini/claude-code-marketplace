{
  "description": "Memory hooks for automatic capture and retrieval using mem0",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/on-session-start.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "prompt",
            "prompt_file": "${CLAUDE_PLUGIN_ROOT}/hooks/prompts/on-stop.md"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "prompt",
            "prompt_file": "${CLAUDE_PLUGIN_ROOT}/hooks/prompts/on-session-end.md"
          }
        ]
      }
    ]
  }
}
